{
  "name": "air-operations",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "sim": "tsx src/cli/batch.ts",
    "e2e": "tsx tests/e2e/definition-of-done.ts",
    "balance": "tsx src/cli/batch.ts --seeds 1000 --json reports/balance.json",
    "params": "tsx src/cli/parameters.ts",
    "manual": "tsx src/cli/manual.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
