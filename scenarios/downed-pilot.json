  "ceconMessages": [
    {
      "atSeconds": 0,
      "text": "Hobo 2 went down west of the valley road at 1720. One parachute seen. Survival radio on guard. JOLLY-1 is being readied and can launch at 1820; CAS-2 at 1830."
    },
    {
      "atSeconds": 30,
      "text": "The survivor stays silent to save battery. Ask for a position or SITREP when you need one, but every call can give it away to the enemy searching for it."
    },
    {
      "atSeconds": 600,
      "text": "Get eyes over the survivor and forward what you see to it: knowing where the hunters are is what keeps it hidden."
    },
    {
      "atSeconds": 2700,
      "text": "Put strike aircraft over the pickup before JOLLY-1 goes in. On the ground a helicopter is an easy target, and boarding takes about 20 seconds."
    },
    {
      "atSeconds": 3300,
      "text": "JOLLY-1 is ready. Right-click on the survivor's position for Pick up here. If the fire gets heavy, lift off and try again."
    }
